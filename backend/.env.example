DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
PORT=4000

# Optional — only needed for /api/geofences' geocode-by-name convenience
# and the distance-matrix info endpoint. The actual geofence check
# (isUserInGeofence) is plain Haversine math and needs no API key at all.
GOOGLE_MAPS_API_KEY=
