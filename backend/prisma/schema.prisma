generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev (zero install). Swap to "postgresql" + a real
  // DATABASE_URL when deploying — the schema below is Postgres-compatible.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjects    Subject[]
  attendance  Attendance[]
  geofences            Geofence[]
  cgpaSession          CgpaSession?
  ocrCorrections       OcrCorrection[]
  predictionCorrections PredictionCorrection[]
}

model Subject {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  code       String?
  teacher    String?
  credits    Int?
  courseType String? // theory | lab | practical
  roomNumber        String?
  color             String?
  tags              String? // JSON-encoded string array
  commencementDate  String? // YYYY-MM-DD — when this subject's classes started, for predictions
  semesterWeeks     Int      @default(16)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attendance          Attendance[]
  syllabusBlocks      SyllabusBlock[]
  geofences           Geofence[]
  schedules           ClassSchedule[]
  predictionCorrections PredictionCorrection[]

  @@index([userId])
}

model Attendance {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD
  status     String // present | absent | leave
  method     String    @default("manual") // manual | automatic
  geofenceId String?
  geofence   Geofence? @relation(fields: [geofenceId], references: [id], onDelete: SetNull)
  latitude   Float?
  longitude  Float?
  accuracyM  Float?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([userId, subjectId, date])
}

// A subject's weekly class times — needed to answer "is a class scheduled
// right now", which auto-mark depends on. Mirrors the mobile app's local
// per-period start/end time (mobile/src/lib/findCurrentPeriod.js) but
// keyed by day-of-week rather than embedded in a per-day period list,
// since the backend has no per-day timetable structure of its own.
model ClassSchedule {
  id        String   @id @default(uuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek String // Mon | Tue | Wed | Thu | Fri | Sat | Sun
  startTime String // HH:MM, 24h
  endTime   String // HH:MM, 24h
  createdAt DateTime @default(now())

  @@index([subjectId, dayOfWeek])
}

model SyllabusBlock {
  id             String   @id @default(uuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title          String
  content        String?
  blockOrder     Int
  estimatedHours Float?
  deadline       String?
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studySchedule StudySchedule[]

  @@index([subjectId])
}

model StudySchedule {
  id                    String    @id @default(uuid())
  blockId               String
  block                 SyllabusBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  plannedCompletionDate String? // YYYY-MM-DD
  actualCompletionDate  String?
  status                String    @default("not_started") // not_started | in_progress | completed
  createdAt             DateTime  @default(now())

  @@index([blockId])
}

model Geofence {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId  String?
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  label      String // e.g. "MAIT main building"
  roomNumber String?
  building   String?
  latitude   Float
  longitude  Float
  radiusM    Float    @default(50)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attendance Attendance[]

  @@index([userId])
  @@index([subjectId])
}

model PredictionCorrection {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  expectedBlockId String?
  actualBlockId   String?
  reason          String?
  accuracyImpact  Float? // positive if the correction shows the prediction was roughly right, negative if far off
  createdAt       DateTime @default(now())

  @@index([userId, subjectId])
}

// A user's correction to a scan classification — checked before the
// heuristics on future scans, and kept as a record of where the
// classifier gets it wrong.
model OcrCorrection {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalText  String
  correctedType String // subject | teacher | break | room | time
  createdAt     DateTime @default(now())

  @@index([userId])
}

// Caches fetched CGPA data. Deliberately holds no GGSIPU credentials —
// login happens in an in-app browser against the real portal; this only
// stores what was read off the resulting page.
model CgpaSession {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentNo   String?
  cgpa           Float?
  semesterData   String? // JSON-encoded
  lastFetchedAt  DateTime?
}
